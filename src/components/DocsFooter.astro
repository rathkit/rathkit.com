---
// Keeps Starlight's footer (page navigation) and adds the same owner and
// publisher line the rest of the site shows.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>
<p class="legal">© 2026 Steven Rathbauer · Published by Rathkit LLC <span class="keep">· <a href="/privacy/">Privacy</a></span></p>

<style>
  .legal {
    margin-top: 2rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .keep {
    white-space: nowrap;
  }
  .legal a {
    color: inherit;
  }
</style>
